# Required to authorize sending endpoints. Use a long random value (32+ bytes).
NEXUS_API_KEY=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=production

# Exact dashboard origin(s), comma-separated; never use * with credentialed admin APIs.
# Example after publishing the dashboard: https://your-dashboard.example.com
CORS_ORIGIN=https://your-dashboard.example.com

# SMTP email and email OTP. Use your own SMTP host if you want to operate your own mail infrastructure.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="Nexus Notify <noreply@example.com>"

# Optional: HTTPS endpoints for YOUR carrier/modem bridge or authorized WhatsApp Business integration.
# The receiving gateway should accept POST JSON and respond with 2xx only after accepting the request.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=

# Optional writable persistent directory for hashed OTP state. Back it up securely.
DATA_DIR=./data
