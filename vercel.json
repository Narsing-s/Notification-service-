{
  "version": 2,
  "builds": [
    {
      "src": "api/[...path].js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "nexus-icon.svg",
      "use": "@vercel/static"
    },
    {
      "src": "openapi.yaml",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/api(?:/.*)?$",
      "dest": "/api/[...path].js"
    },
    {
      "src": "^/favicon\\.ico$",
      "dest": "/nexus-icon.svg"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 10
    }
  }
}
